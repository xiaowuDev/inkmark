{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "InkMark",
  "version": "0.1.0",
  "identifier": "com.zhuanz.inkmark",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "InkMark",
        "width": 1320,
        "height": 860,
        "minWidth": 920,
        "minHeight": 620,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 22
        }
      }
    ],
    "security": {
      "csp": "default-src 'self' asset: http://asset.localhost; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self' 'unsafe-eval'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "copyright": "Copyright © 2026 Zhuanz",
    "shortDescription": "A fast, local-first Markdown editor.",
    "longDescription": "InkMark is a private, local-first Markdown editor with instant rendering, workspace navigation, tabs, and reliable autosave.",
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/xiaowuDev/inkmark/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZBQzM1ODlGMzZGMEU2QUUKUldTdTV2QTJuMWpEK3ZvdUxzOFh1R013dzBxZHlBL05ITXE2Smdqck1UK0hrZUorM3BHRXFJWEMK"
    }
  }
}
